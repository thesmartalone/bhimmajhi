rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /posts/{userId}/{fileName} {
      // Website visitors can view published media.
      allow read: if true;

      // Only the signed-in admin account may upload/delete.
      allow write:
        if request.auth != null
        && request.auth.token.email == "cutenrml@gmail.com"
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
    }
  }
}
